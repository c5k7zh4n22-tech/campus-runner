# Public browser-safe configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# Server runtime configuration
APP_URL=http://localhost:3000
AUTH_PROVIDER=postgres-cookie
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=local-storage
SMS_PROVIDER=disabled
WECHAT_PROVIDER=official-account

# PostgreSQL and app auth
DATABASE_URL=postgresql://campus_runner:campus_runner_password@postgres:5432/campus_runner
DATABASE_SSL=false
DATABASE_POOL_MAX=10
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=cr_session
# Auto uses HTTPS when APP_URL/NEXT_PUBLIC_SITE_URL starts with https://.
# Set false only for local LAN HTTP testing, for example phone access via http://192.168.x.x:3000.
AUTH_COOKIE_SECURE=
SERVER_ACTION_ALLOWED_ORIGINS=

# Local object storage for Debian/Docker deployment
LOCAL_STORAGE_ROOT=/app/public/uploads
NEXT_PUBLIC_STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_IMAGE_REMOTE_HOSTS=

# Future domestic SMS provider
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# WeChat official account login is disabled until app_users identity binding is implemented.
WECHAT_LOGIN_ENABLED=false
WECHAT_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
